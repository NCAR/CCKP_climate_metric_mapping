VARS="cdd cdd65 cwd fd gsl hd30 hd35 hd40 hd42 hd45 hd50 hdd65 hi hi35 hi37 hi39 hi41 hurs id pr r20mm r50mm rx1day rx5day sd sdii spei12 tas tasmax tasmin tnn tr tr23 tr26 tr32 tx84rr txx wbt wbt25 wbt27 wbt29 wbt31 wd wsdi"
mkdir -p logs

for v in $VARS; do
